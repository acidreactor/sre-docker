    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Норма для OLTP > 99%",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(pg_stat_database_blks_hit{instance=~\"$instance\"}[5m])) / (sum by (instance) (rate(pg_stat_database_blks_hit{instance=~\"$instance\"}[5m])) + sum by (instance) (rate(pg_stat_database_blks_read{instance=~\"$instance\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
