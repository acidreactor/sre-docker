  "templating": {
    "list": [
      {
        "type": "query",
        "name": "container",
        "label": "Контейнер",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{name=~\"sre-.+\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(container_memory_working_set_bytes{name=~\"sre-.+\"}, name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Дашборды SRE",
      "type": "dashboards",
      "tags": [
        "sre"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Смена лидера Patroni",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "changes(max(patroni_postgres_timeline)[1m:15s]) > 0",
        "step": "30s",
        "titleFormat": "Failover / switchover"
